  </PropertyGroup>
  <ItemGroup>
    <Compile Include="App.xaml.cs">
      <DependentUpon>App.xaml</DependentUpon>
    </Compile>
    <Compile Include="MainPage.xaml.cs">
      <DependentUpon>MainPage.xaml</DependentUpon>
    </Compile>
    <Compile Include="Bridge\AppBridge.cs" />
    <Compile Include="Diagnostics\Log.cs" />
    <Compile Include="Input\ControllerBridge.cs" />
    <Compile Include="Playback\HttpMediaInput.cs" />
    <Compile Include="Playback\VlcPlayer.cs" />
